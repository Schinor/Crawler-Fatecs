{
  "openapi": "3.1.0",
  "info": {
    "title": "FatecOrg API",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "infra"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/unidades": {
      "get": {
        "tags": [
          "catálogo"
        ],
        "summary": "Listar Unidades",
        "description": "Unidades e cursos cadastrados (espelho do seed do crawler).",
        "operationId": "listar_unidades_unidades_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Unidade"
                  },
                  "type": "array",
                  "title": "Response Listar Unidades Unidades Get"
                }
              }
            }
          }
        }
      }
    },
    "/ppcs": {
      "get": {
        "tags": [
          "ppcs"
        ],
        "summary": "Listar Versoes",
        "description": "Versões de documentos, da mais recente para a mais antiga.",
        "operationId": "listar_versoes_ppcs_get",
        "parameters": [
          {
            "name": "unidade",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Unidade"
            }
          },
          {
            "name": "curso",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Curso"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limite"
            }
          },
          {
            "name": "deslocamento",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100000,
              "minimum": 0,
              "default": 0,
              "title": "Deslocamento"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Versao"
                  },
                  "title": "Response Listar Versoes Ppcs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "ppcs"
        ],
        "summary": "Enviar Versao",
        "description": "Upload manual de um documento (ex.: PPC que o crawler não pode baixar do Drive).\n\nExige `Authorization: Bearer <API_TOKEN_UPLOAD>`. Fecha os avisos abertos do curso para o\nmesmo tipo de documento.",
        "operationId": "enviar_versao_ppcs_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_enviar_versao_ppcs_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Versao"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "413": {
            "description": "Request Entity Too Large"
          },
          "415": {
            "description": "Unsupported Media Type"
          },
          "503": {
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ppcs/{unidade}/{curso}/{sha256}": {
      "get": {
        "tags": [
          "ppcs"
        ],
        "summary": "Detalhar Versao",
        "operationId": "detalhar_versao_ppcs__unidade___curso___sha256__get",
        "parameters": [
          {
            "name": "unidade",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
              "title": "Unidade"
            }
          },
          {
            "name": "curso",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
              "title": "Curso"
            }
          },
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Versao"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ppcs/{unidade}/{curso}/{sha256}/arquivo": {
      "get": {
        "tags": [
          "ppcs"
        ],
        "summary": "Baixar Arquivo",
        "operationId": "baixar_arquivo_ppcs__unidade___curso___sha256__arquivo_get",
        "parameters": [
          {
            "name": "unidade",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
              "title": "Unidade"
            }
          },
          {
            "name": "curso",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
              "title": "Curso"
            }
          },
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ppcs/{unidade}/{curso}/{sha256}/texto": {
      "get": {
        "tags": [
          "ppcs"
        ],
        "summary": "Baixar Texto",
        "operationId": "baixar_texto_ppcs__unidade___curso___sha256__texto_get",
        "parameters": [
          {
            "name": "unidade",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
              "title": "Unidade"
            }
          },
          {
            "name": "curso",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
              "title": "Curso"
            }
          },
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/avisos": {
      "get": {
        "tags": [
          "avisos"
        ],
        "summary": "Listar Avisos",
        "description": "Avisos abertos para o banner do front-end (ex.: PPC no Drive bloqueado pelo robots.txt).",
        "operationId": "listar_avisos_avisos_get",
        "parameters": [
          {
            "name": "unidade",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Unidade"
            }
          },
          {
            "name": "curso",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Curso"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Aviso"
                  },
                  "title": "Response Listar Avisos Avisos Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Aviso": {
        "properties": {
          "tipo": {
            "$ref": "#/components/schemas/TipoAviso"
          },
          "unidade_slug": {
            "type": "string",
            "title": "Unidade Slug"
          },
          "curso_slug": {
            "type": "string",
            "title": "Curso Slug"
          },
          "curso_nome": {
            "type": "string",
            "title": "Curso Nome"
          },
          "tipo_documento": {
            "$ref": "#/components/schemas/TipoDocumento",
            "default": "ppc"
          },
          "pagina_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Pagina Url"
          },
          "arquivo_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Arquivo Url"
          },
          "titulo_link": {
            "type": "string",
            "title": "Titulo Link",
            "default": ""
          },
          "mensagem": {
            "type": "string",
            "title": "Mensagem"
          },
          "detectado_em": {
            "type": "string",
            "format": "date-time",
            "title": "Detectado Em"
          },
          "visto_em": {
            "type": "string",
            "format": "date-time",
            "title": "Visto Em"
          }
        },
        "type": "object",
        "required": [
          "tipo",
          "unidade_slug",
          "curso_slug",
          "curso_nome",
          "pagina_url",
          "arquivo_url",
          "mensagem",
          "detectado_em",
          "visto_em"
        ],
        "title": "Aviso",
        "description": "Aviso aberto sobre um documento que o crawler encontrou mas não pôde baixar.\n\nUm aviso por (unidade, curso, arquivo_url). Some quando a unidade é coletada de novo e o\nproblema não aparece mais."
      },
      "Body_enviar_versao_ppcs_post": {
        "properties": {
          "arquivo": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Arquivo"
          },
          "unidade": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
            "title": "Unidade"
          },
          "curso": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
            "title": "Curso"
          },
          "tipo_documento": {
            "$ref": "#/components/schemas/TipoDocumento",
            "default": "ppc"
          },
          "titulo": {
            "type": "string",
            "maxLength": 200,
            "title": "Titulo",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "arquivo",
          "unidade",
          "curso"
        ],
        "title": "Body_enviar_versao_ppcs_post"
      },
      "CursoSeed": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "nome",
          "url"
        ],
        "title": "CursoSeed",
        "description": "Curso cadastrado no seed, com a página onde a unidade publica seus documentos."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Links": {
        "properties": {
          "arquivo": {
            "type": "string",
            "title": "Arquivo"
          },
          "texto": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Texto"
          }
        },
        "type": "object",
        "required": [
          "arquivo",
          "texto"
        ],
        "title": "Links"
      },
      "OrigemVersao": {
        "type": "string",
        "enum": [
          "crawler",
          "upload"
        ],
        "title": "OrigemVersao"
      },
      "Plataforma": {
        "type": "string",
        "enum": [
          "google_sites",
          "wordpress",
          "generico"
        ],
        "title": "Plataforma"
      },
      "TipoAviso": {
        "type": "string",
        "enum": [
          "drive_bloqueado"
        ],
        "title": "TipoAviso",
        "description": "Problema que impede a coleta e precisa de ação humana. Aparece como aviso no front-end."
      },
      "TipoDocumento": {
        "type": "string",
        "enum": [
          "ppc",
          "matriz",
          "ementario"
        ],
        "title": "TipoDocumento",
        "description": "Tipo do documento curricular coletado. Marília, por exemplo, só publica matriz e ementa."
      },
      "Unidade": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "cidade": {
            "type": "string",
            "title": "Cidade"
          },
          "site_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Site Url"
          },
          "plataforma": {
            "$ref": "#/components/schemas/Plataforma"
          },
          "cursos": {
            "items": {
              "$ref": "#/components/schemas/CursoSeed"
            },
            "type": "array",
            "title": "Cursos",
            "default": []
          },
          "ativa": {
            "type": "boolean",
            "title": "Ativa",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "slug",
          "nome",
          "cidade",
          "site_url",
          "plataforma"
        ],
        "title": "Unidade"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Versao": {
        "properties": {
          "unidade": {
            "type": "string",
            "title": "Unidade"
          },
          "curso": {
            "type": "string",
            "title": "Curso"
          },
          "curso_nome": {
            "type": "string",
            "title": "Curso Nome"
          },
          "tipo_documento": {
            "$ref": "#/components/schemas/TipoDocumento"
          },
          "origem": {
            "$ref": "#/components/schemas/OrigemVersao"
          },
          "formato": {
            "type": "string",
            "title": "Formato"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "tamanho_bytes": {
            "type": "integer",
            "title": "Tamanho Bytes"
          },
          "paginas": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paginas"
          },
          "precisa_ocr": {
            "type": "boolean",
            "title": "Precisa Ocr"
          },
          "titulo": {
            "type": "string",
            "title": "Titulo"
          },
          "pagina_url": {
            "type": "string",
            "title": "Pagina Url"
          },
          "arquivo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arquivo Url"
          },
          "coletado_em": {
            "type": "string",
            "format": "date-time",
            "title": "Coletado Em"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          }
        },
        "type": "object",
        "required": [
          "unidade",
          "curso",
          "curso_nome",
          "tipo_documento",
          "origem",
          "formato",
          "sha256",
          "tamanho_bytes",
          "paginas",
          "precisa_ocr",
          "titulo",
          "pagina_url",
          "arquivo_url",
          "coletado_em",
          "links"
        ],
        "title": "Versao"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
