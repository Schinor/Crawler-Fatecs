# Copie para .env (que NÃO é versionado) e ajuste. Nunca coloque segredos reais neste arquivo.
# Banco
DATABASE_URL=postgresql+psycopg://fatecorg:fatecorg@localhost:5432/fatecorg

# Object storage (MinIO no dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=fatecorg
S3_SECRET_KEY=fatecorg-secret
S3_BUCKET=ppcs

# Crawler
CRAWLER_USER_AGENT=FatecOrg-Crawler/0.1 (+https://github.com/<org>/bd-ppcs; contato: <email-da-equipe>)
CRAWLER_DELAY_SECONDS=2.0
CRAWLER_DATA_DIR=./data
