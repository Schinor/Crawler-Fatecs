# Modelo do .env. Para criar o seu com segredos aleatórios: make env
# O .env NÃO é versionado. Nunca coloque segredos reais ou e-mails neste arquivo.

# Banco (Postgres local do docker compose)
POSTGRES_USER=fatecorg
POSTGRES_PASSWORD=<gerado-por-make-env>
POSTGRES_DB=fatecorg
DATABASE_URL=postgresql+psycopg://fatecorg:<senha>@localhost:5432/fatecorg

# Object storage: Garage (S3 compatível)
GARAGE_RPC_SECRET=<gerado-por-make-env>
GARAGE_ADMIN_TOKEN=<gerado-por-make-env>
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY=<gerado-por-make-env>
S3_SECRET_KEY=<gerado-por-make-env>
S3_BUCKET=ppcs

# Crawler. O contato no User-Agent é o responsável pelo crawler (hoje: Marcio).
# Coloque o e-mail de contato só no seu .env local.
CRAWLER_USER_AGENT=FatecOrg-Crawler/0.1 (+https://github.com/Schinor/Crawler-Fatecs)
CRAWLER_DELAY_SECONDS=2.0
CRAWLER_DATA_DIR=./data

# Notificações de nova versão de PPC (Fase 2). Lista separada por vírgula.
NOTIFICACAO_DESTINATARIOS=
